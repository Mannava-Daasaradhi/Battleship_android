{
  "rules": {
    ".read": false,
    ".write": false,

    "roomCodes": {
      ".read": "auth != null",
      "$roomCode": {
        ".write": "auth != null && !data.exists()",
        "gameId": { ".validate": "newData.isString() && newData.val().length > 0" },
        "$other": { ".validate": false }
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null && (data.child('meta/hostUid').val() === auth.uid || data.child('meta/guestUid').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && newData.child('meta/hostUid').val() === auth.uid",

        "meta": {
          "hostUid": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString()"
          },
          "guestUid": {
            ".write": "auth != null && data.val() === null && newData.val() === auth.uid",
            ".validate": "newData.isString()"
          },
          "status": {
            ".write": "auth != null && ((data.val() === null && newData.val() === 'waiting') || (data.val() === 'waiting' && newData.val() === 'setup' && root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid) || (data.val() === 'setup' && newData.val() === 'battle') || (data.val() === 'battle' && newData.val() === 'finished' && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)))",
            ".validate": "newData.val() === 'waiting' || newData.val() === 'setup' || newData.val() === 'battle' || newData.val() === 'finished'"
          },
          "winner": {
            ".write": "auth != null && data.val() === null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
            ".validate": "newData.isString()"
          },
          "currentTurn": {
            ".write": "auth != null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
            ".validate": "newData.isString()"
          },
          "createdAt": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".write": "auth != null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
            ".validate": "newData.isNumber()"
          },
          "roomCode": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString()"
          },
          "$other": { ".validate": false }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "ready": { ".validate": "newData.isBoolean()" },
            "connected": { ".validate": "newData.isBoolean()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "boards": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".read": "auth != null && auth.uid === $uid",
            "ships": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },

        "shots": {
          "$shooterUid": {
            "$shotPushKey": {
              ".write": "auth != null && auth.uid === $shooterUid && !data.exists()",
              ".validate": "newData.hasChildren(['row','col','timestamp']) && (newData.child('result').val() === null || auth.uid !== $shooterUid)",
              "row": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
              "col": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
              "timestamp": { ".validate": "newData.isNumber()" },
              "result": {
                ".write": "auth != null && auth.uid !== $shooterUid && !data.exists() && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
                ".validate": "newData.val() === 'hit' || newData.val() === 'miss' || newData.val() === 'sunk'"
              },
              "shipId": {
                ".write": "auth != null && auth.uid !== $shooterUid && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
                ".validate": "newData.isString()"
              },
              "$other": { ".validate": false }
            }
          }
        },

        "chat": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
