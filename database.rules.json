{
  "rules": {
    "roomCodes": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        "gameId": {
          ".validate": "newData.isString() && newData.val().length < 40"
        }
      }
    },
    "games": {
      ".indexOn": ["meta/createdAt"],
      "$gameId": {
        ".write": "auth != null && !data.exists() && newData.child('meta/hostUid').val() === auth.uid && newData.child('meta/status').val() === 'waiting' && !newData.child('meta/winner').exists() && !newData.child('meta/guestUid').exists() && !newData.child('shots').exists() && !newData.child('boards').exists()",

        "meta": {
          ".read": "auth != null && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || data.child('status').val() === 'waiting')",
          "hostUid": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
          },
          "guestUid": {
            ".write": "auth != null && data.val() === null && newData.val() === auth.uid && root.child('games').child($gameId).child('meta/hostUid').val() !== auth.uid"
          },
          "status": {
            ".write": "auth != null && ((data.val() === null && newData.val() === 'waiting') || (data.val() === 'waiting' && newData.val() === 'setup' && root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid) || (data.val() === 'setup' && newData.val() === 'battle' && root.child('games').child($gameId).child('boards').child(root.child('games').child($gameId).child('meta/hostUid').val()).exists() && root.child('games').child($gameId).child('boards').child(root.child('games').child($gameId).child('meta/guestUid').val()).exists()) || (data.val() === 'battle' && newData.val() === 'finished' && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)))",
            ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'setup' || newData.val() === 'battle' || newData.val() === 'finished')"
          },
          "winner": {
            ".write": "auth != null && !data.exists() && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
            ".validate": "newData.isString() && (newData.val() === newData.parent().child('hostUid').val() || newData.val() === newData.parent().child('guestUid').val())"
          },
          "currentTurn": {
            ".write": "auth != null && ((data.val() === null && root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid) || (root.child('games').child($gameId).child('meta/status').val() === 'battle' && data.val() !== auth.uid && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)))",
            ".validate": "newData.isString() && (newData.val() === newData.parent().child('hostUid').val() || newData.val() === newData.parent().child('guestUid').val())"
          },
          "createdAt": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.val() <= now"
          },
          "updatedAt": {
            ".write": "auth != null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)"
          },
          "roomCode": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length <= 8"
          }
        },

        "players": {
          ".read": "auth != null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)"
          }
        },

        "boards": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($gameId).child('meta/status').val() === 'setup'",
            "ships": {
              ".validate": "newData.isString() && newData.val().length < 2000"
            }
          }
        },

        "shots": {
          ".read": "auth != null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
          "$shooterUid": {
            "$shotPushKey": {
              ".write": "auth != null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid) && root.child('games').child($gameId).child('meta/status').val() === 'battle' && ((auth.uid === $shooterUid && !data.exists() && root.child('games').child($gameId).child('meta/currentTurn').val() === auth.uid) || (auth.uid !== $shooterUid && data.exists() && !data.child('result').exists()))",
              ".validate": "newData.hasChildren(['row','col','timestamp']) && (!newData.child('result').exists() || auth.uid !== $shooterUid) && (!newData.child('shipId').exists() || auth.uid !== $shooterUid)",
              "row": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && (!data.exists() || newData.val() === data.val())" },
              "col": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && (!data.exists() || newData.val() === data.val())" },
              "timestamp": { ".validate": "newData.val() <= now && (!data.exists() || newData.val() === data.val())" },
              "result": { ".validate": "newData.isString() && (newData.val() === 'hit' || newData.val() === 'miss' || newData.val() === 'sunk')" },
              "shipId": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "$other": { ".validate": false }
            }
          }
        },

        "chat": {
          ".read": "auth != null && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
          "$messageId": {
            ".write": "auth != null && !data.exists() && (root.child('games').child($gameId).child('meta/hostUid').val() === auth.uid || root.child('games').child($gameId).child('meta/guestUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','text','timestamp'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
            "timestamp": { ".validate": "newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "$other": { ".read": false, ".write": false }
  }
}
